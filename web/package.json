{
  "name": "chatti-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "smoke": "vitest run --config vitest.smoke.config.ts",
    "qa:interop": "vitest run --config scripts/interop.vitest.config.ts",
    "qa:reconnect": "vitest run --config scripts/reconnect.vitest.config.ts",
    "qa:bug01": "vitest run --config scripts/bug01.vitest.config.ts",
    "qa:bug01:stress": "BUG01_STRESS=1 vitest run --config scripts/bug01.vitest.config.ts",
    "qa:regression": "vitest run && vitest run --config scripts/interop.vitest.config.ts && vitest run --config scripts/reconnect.vitest.config.ts"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^7.18.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^16.5.0",
    "jsdom": "^30.0.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^7.3.7",
    "vitest": "^4.1.11"
  }
}
